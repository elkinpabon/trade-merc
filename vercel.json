{
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/paper",
      "schedule": "*/15 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://trademerc.elkinext.lat",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ]
}
