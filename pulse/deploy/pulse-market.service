[Unit]
Description=PULSE independent paper market research
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=elkin
WorkingDirectory=/home/elkin/pulse-market
EnvironmentFile=/home/elkin/.config/pulse-market/service.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/elkin/pulse-market/.venv/bin/python -m uvicorn pulse.api:app --host 127.0.0.1 --port 3400 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=15
TimeoutStopSec=50
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=1200M
CPUQuota=150%
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
